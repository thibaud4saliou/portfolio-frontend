# En local : copier en ".env.local". Sur Vercel : Settings → Environment Variables.

# URL du backend (utilisée par le serveur Next ET par le proxy /api).
# Local : http://localhost:5001   Production : https://<votre-backend>.onrender.com (par ex.)
API_INTERNAL_URL=http://localhost:5001

# URL publique du site (sitemap, balises SEO)
SITE_URL=http://localhost:3000

# Optionnel : hôtes autorisés pour l'upload direct (CSP connect-src)
# UPLOAD_CONNECT_SRC=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
